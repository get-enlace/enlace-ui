{
  "name": "enlace",
  "private": true,
  "version": "0.1.0",
  "description": "Enlace — a visual, chained-execution canvas that plugs into an existing OpenAPI-documented API. This repo hosts @get-enlace/ui plus an example API for local testing. Adapters (Express, ...) live in github.com/get-enlace/enlace-js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/get-enlace/enlace-ui.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/ensure-ui-built.mjs",
    "predev:no-auth": "node scripts/ensure-ui-built.mjs",
    "dev": "tsx watch examples/sample-api/server.ts",
    "dev:no-auth": "cross-env ENLACE_EXAMPLE_NO_AUTH=1 tsx watch examples/sample-api/server.ts",
    "start": "npm run dev",
    "start:no-auth": "npm run dev:no-auth",
    "build": "npm run build:ui",
    "build:ui": "npm run build --workspace @get-enlace/ui",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspace @get-enlace/ui && vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e-ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/swagger-ui-express": "^4.1.6",
    "cross-env": "^10.1.0",
    "express": "^4.19.2",
    "jose": "^6.2.10",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "oauth2-mock-server": "^9.1.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "multer": "^2.3.0"
  }
}
