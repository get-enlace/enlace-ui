{
  "openapi": "3.0.3",
  "info": { "title": "Sample Store API", "version": "1.0.0" },
  "servers": [{ "url": "http://localhost:4000" }],
  "paths": {
    "/customers": {
      "post": {
        "tags": ["Customers"],
        "summary": "Create a customer",
        "operationId": "createCustomer",
        "security": [{ "basicAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "email": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": ["Customers"],
        "summary": "Fetch a customer by id",
        "operationId": "getCustomerById",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Customer found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "email": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Customer not found" }
        }
      },
      "patch": {
        "tags": ["Customers"],
        "summary": "Update a customer",
        "operationId": "updateCustomer",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "dryRun",
            "in": "query",
            "required": false,
            "description": "When true, validate the update but do not persist it.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "notify",
            "in": "query",
            "required": false,
            "description": "Send a notification about the update.",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "email": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Customer not found" }
        }
      },
      "delete": {
        "tags": ["Customers"],
        "summary": "Delete a customer",
        "operationId": "deleteCustomer",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Customer deleted" },
          "404": { "description": "Customer not found" }
        }
      }
    },
    "/products": {
      "post": {
        "tags": ["Products"],
        "summary": "Create a product",
        "operationId": "createProduct",
        "security": [{ "oauth2Password": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["name", "price"],
                "properties": {
                  "name": { "type": "string" },
                  "price": { "type": "number", "minimum": 0 },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional product image — written under the server temp dir; location returned on the product"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "price": { "type": "number" },
                    "inStock": { "type": "boolean" },
                    "imageLocation": {
                      "type": "string",
                      "nullable": true,
                      "description": "Absolute path under the server temp dir when an image was uploaded"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Fetch a product by id",
        "operationId": "getProductById",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Product found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "price": { "type": "number" },
                    "inStock": { "type": "boolean" },
                    "imageLocation": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "404": { "description": "Product not found" }
        }
      },
      "patch": {
        "tags": ["Products"],
        "summary": "Update a product",
        "operationId": "updateProduct",
        "security": [{ "oauth2Password": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "price": { "type": "number" },
                  "inStock": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "price": { "type": "number" },
                    "inStock": { "type": "boolean" },
                    "imageLocation": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "404": { "description": "Product not found" }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Delete a product",
        "operationId": "deleteProduct",
        "security": [{ "oauth2Password": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Product deleted" },
          "404": { "description": "Product not found" }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": ["Orders"],
        "summary": "Create an order (references an existing customer + product)",
        "operationId": "createOrder",
        "security": [{ "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customerId", "productId", "qty"],
                "properties": {
                  "customerId": { "type": "string" },
                  "productId": { "type": "string" },
                  "qty": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "customerId": { "type": "string" },
                    "productId": { "type": "string" },
                    "qty": { "type": "integer" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Unknown customerId or productId" }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Fetch an order by id",
        "operationId": "getOrderById",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Order found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "customerId": { "type": "string" },
                    "productId": { "type": "string" },
                    "qty": { "type": "integer" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Order not found" }
        }
      },
      "patch": {
        "tags": ["Orders"],
        "summary": "Update an order",
        "operationId": "updateOrder",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string" },
                  "qty": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "customerId": { "type": "string" },
                    "productId": { "type": "string" },
                    "qty": { "type": "integer" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Order not found" }
        }
      },
      "delete": {
        "tags": ["Orders"],
        "summary": "Delete an order",
        "operationId": "deleteOrder",
        "security": [{ "oauth2ClientCreds": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Order deleted" },
          "404": { "description": "Order not found" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Required on POST /customers. Demo-only: any username/password is accepted"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required on PATCH/DELETE /customers/{id}. Demo-only: any bearer token is accepted"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Required on POST /orders. Demo-only: any value is accepted"
      },
      "oauth2ClientCreds": {
        "type": "oauth2",
        "description": "Required on DELETE /orders/{id}. Genuinely enforced: the sample server verifies the token's signature against the local mock issuer's JWK. Any client_id/client_secret is accepted at the token endpoint itself.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "http://localhost:4001/token",
            "scopes": { "orders:delete": "Cancel/delete orders" }
          }
        }
      },
      "oauth2Password": {
        "type": "oauth2",
        "description": "Required on POST/PATCH/DELETE /products. Genuinely enforced, the sample server verifies the token's signature against the local mock issuer's JWK. Any username/password is accepted at the token endpoint itself.",
        "flows": {
          "password": {
            "tokenUrl": "http://localhost:4001/token",
            "scopes": { "products:write": "Create, update, and delete products" }
          }
        }
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "enlace_demo_session",
        "description": "Required on PATCH /orders/{id}. Demo-only: log in first at GET /auth/demo-login (open it as the credential's optional Login page URL) — it sets this cookie directly, no redirect. Since Enlace's canvas and this API share an origin, the browser carries the cookie automatically afterward."
      }
    }
  }
}
